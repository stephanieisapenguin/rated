# Frontend (Vite) environment variables.
# Copy to .env.local for local dev. Vite only exposes vars prefixed with VITE_.
# In production, set these in Netlify → Site settings → Environment variables.
# Canonical values live in GitHub repo secrets — see README for how to pull them.

# Backend API base URL.
# Local dev:  http://localhost:8000
# Production: https://rated-api.onrender.com
VITE_API_BASE_URL=http://localhost:8000

# Pre-signed auth appended to every API request (the signature IS the auth).
# Leave empty for local FastAPI dev (no auth required against localhost).
# Get the production value from GitHub → Settings → Secrets → VITE_API_AUTH.
VITE_API_AUTH=

# Google OAuth client ID (public — safe to share, not a secret).
VITE_GOOGLE_CLIENT_ID=830176116158-iu98jg23p45sgetoimbjei6mce4ifofu.apps.googleusercontent.com

# Note: there is no longer a VITE_TMDB_API_KEY — TMDB calls go through the
# backend's /tmdb/* proxy so the key stays server-side. Set TMDB_API_KEY on
# the backend instead (see backend/.env.example).
